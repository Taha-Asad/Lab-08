@page "{id:int}"
@model PMS_CRUD_Razor.Pages.Products.EditModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <h2 class="mb-4">Edit Product</h2>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form method="post" enctype="multipart/form-data">
            <!-- CRITICAL: Preserve the existing ID and Image in hidden inputs -->
            <input type="hidden" asp-for="Product.Id" />
            <input type="hidden" asp-for="Product.image" />

            <div class="mb-3">
                <label asp-for="Product.Title" class="form-label">Title</label>
                <input asp-for="Product.Title" class="form-control" />
                <span asp-validation-for="Product.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Product.description" class="form-label">Description</label>
                <textarea asp-for="Product.description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Product.description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Current Image</label>
                <div>
                    @if (!string.IsNullOrEmpty(Model.Product.image))
                    {
                        <img src="@Url.Content("~/" + Model.Product.image)" alt="Product Image" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border mb-2" />
                    }
                </div>
                <label asp-for="ImageFile" class="form-label">Change Image (optional)</label>
                <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Product.price" class="form-label">Price</label>
                <input asp-for="Product.price" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="Product.price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Product.quantity" class="form-label">Quantity</label>
                <input asp-for="Product.quantity" type="number" min="0" class="form-control" />
                <span asp-validation-for="Product.quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Product.status" class="form-label">Status</label>
                <select asp-for="Product.status" class="form-select">
                    <option value="A">Available</option>
                    <option value="I">Not Available</option>
                </select>
                <span asp-validation-for="Product.status" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Update Product</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}